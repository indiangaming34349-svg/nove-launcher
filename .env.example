# Required for Microsoft OAuth. Register this redirect URI in your Azure app:
# http://127.0.0.1:8765/callback
NOVA_MICROSOFT_CLIENT_ID=

# Optional: CurseForge requires an API key.
NOVA_CURSEFORGE_API_KEY=

# Optional Discord invite used by the launcher widget.
NOVA_DISCORD_INVITE=https://discord.gg/your-server
